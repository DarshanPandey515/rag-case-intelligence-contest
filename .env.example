# --- Required keys ---
# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Qdrant vector database (https://cloud.qdrant.io)
# URL looks like: https://xxxxxxx-xxxxx-xxxx.xxxxx.cloud.qdrant.io:6333
# For local Qdrant (docker): http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=

# --- Optional overrides (sensible defaults shown) ---
# GROQ_MODEL=openai/gpt-oss-120b
# QDRANT_COLLECTION=case_intelligence
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# SPARSE_EMBED_MODEL=Qdrant/bm25
# TOP_K=6
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100